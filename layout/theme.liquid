<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }}{% if page_title != shop.name %} | {{ shop.name }}{% endif %}</title>
  <meta name="description" content="{{ page_description | default: 'Designed for water. Made for everything around it.' }}">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ page_description | default: 'Designed for water. Made for everything around it.' }}">
  <meta property="og:site_name" content="{{ shop.name }}">

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ 'favicon.png' | asset_url }}">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

  <!-- Theme CSS -->
  {{ 'florine-base.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body>
  {{ content_for_layout }}

  {% section 'florine-footer' %}

  <script src="{{ 'florine-animations.js' | asset_url }}" defer></script>
</body>
</html>
