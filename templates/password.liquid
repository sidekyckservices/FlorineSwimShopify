<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} — Coming Soon</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

  {{ 'florine-base.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body>
  <section class="hero" style="min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div class="hero__content" style="text-align: center; max-width: 36rem; margin: 0 auto; padding: 2rem 1.5rem;">
      <img
        src="{{ 'florine-logo.png' | asset_url }}"
        alt="{{ shop.name }}"
        class="hero__logo"
        style="height: 5rem; margin: 0 auto 2rem;"
      />

      <h1 style="font-size: 2.25rem; margin-bottom: 1rem;">Coming Soon</h1>

      <p style="font-family: 'Inter', sans-serif; font-weight: 300; color: hsl(var(--foreground) / 0.7); margin-bottom: 2rem; line-height: 1.6;">
        We are preparing something thoughtful and beautiful. Check back soon.
      </p>

      {% form 'storefront_password' %}
        <div class="waitlist__form-row" style="justify-content: center;">
          <input
            type="password"
            name="password"
            placeholder="Enter store password"
            class="waitlist__input"
            style="max-width: 16rem;"
          />
          <button type="submit" class="btn btn--primary btn--small">
            Enter
          </button>
        </div>
        {% if form.errors %}
          <p class="waitlist__error" style="margin-top: 0.75rem;">
            {{ form.errors | default_errors }}
          </p>
        {% endif %}
      {% endform %}
    </div>
  </section>
</body>
</html>
