<section class="emotional section-padding" style="background-color: {{ section.settings.background_color }};">
  <div class="emotional__inner">
    <div class="emotional__grid">
      <div class="emotional__intro animate-on-scroll">
        <div class="emotional__intro-sticky">
          {% if section.settings.eyebrow != blank %}
            <p class="emotional__eyebrow">{{ section.settings.eyebrow }}</p>
          {% endif %}
          <h2 class="emotional__title">{{ section.settings.heading }}</h2>
          {% if section.settings.lead != blank %}
            <p class="emotional__lead">{{ section.settings.lead }}</p>
          {% endif %}
          {% if section.settings.subnote != blank %}
            <div class="emotional__subnote">
              <span class="emotional__subnote-rule" aria-hidden="true"></span>
              <span class="emotional__subnote-text">{{ section.settings.subnote }}</span>
            </div>
          {% endif %}
        </div>
      </div>

      <ol class="emotional__timeline">
        {% for block in section.blocks %}
          {% assign delay_s = forloop.index0 | times: 0.15 %}
          <li
            class="emotional__step animate-on-scroll"
            data-delay="{{ delay_s }}"
            style="transition-delay: {{ delay_s }}s;"
            {{ block.shopify_attributes }}
          >
            <h3 class="emotional__step-title">{{ block.settings.title }}.</h3>
            <p class="emotional__step-text">{{ block.settings.text }}</p>
          </li>
        {% endfor %}
      </ol>
    </div>

    {% if section.settings.closing_quote != blank %}
      <div class="emotional__closing-wrap animate-on-scroll" data-delay="0.2">
        <p class="emotional__closing">
          {{ section.settings.closing_quote }}
          {%- if section.settings.closing_emphasis != blank -%}
            <span class="emotional__closing-emphasis">{{ section.settings.closing_emphasis }}</span>
          {%- endif -%}
        </p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Emotional",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#D8C3A5"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "— The Florine Feeling"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it should feel."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead Paragraph",
      "default": "When you slip into Florine, you stop thinking about how everything fits — and remember why you came to the water in the first place."
    },
    {
      "type": "text",
      "id": "subnote",
      "label": "Sub-note",
      "default": "a quiet shift, in three movements"
    },
    {
      "type": "textarea",
      "id": "closing_quote",
      "label": "Closing Quote",
      "default": "Florine is swimwear"
    },
    {
      "type": "text",
      "id": "closing_emphasis",
      "label": "Closing Emphasis",
      "default": " you can trust."
    }
  ],
  "blocks": [
    {
      "type": "feeling",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "At Ease"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "You feel comfortable enough to simply move through the day."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Emotional",
      "blocks": [
        {
          "type": "feeling",
          "settings": {
            "title": "Unaware",
            "text": "You forget to adjust or check in the mirror."
          }
        },
        {
          "type": "feeling",
          "settings": {
            "title": "At Ease",
            "text": "You feel comfortable enough to simply move through the day."
          }
        },
        {
          "type": "feeling",
          "settings": {
            "title": "Present",
            "text": "And before long, your attention shifts back to what really matters."
          }
        }
      ]
    }
  ]
}
{% endschema %}
