<section class="brand-story section-padding"
  style="background-color: {{ section.settings.background_color }};{% if section.settings.background_image != blank %} background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}'); background-size: cover; background-position: center;{% endif %}">
  <div class="brand-story__inner animate-on-scroll">
    <h2 class="brand-story__title">{{ section.settings.heading }}</h2>

    {% if section.settings.paragraph_1 != blank %}
      <p class="brand-story__text">{{ section.settings.paragraph_1 }}</p>
    {% endif %}

    {% if section.settings.paragraph_2 != blank %}
      <p class="brand-story__text">{{ section.settings.paragraph_2 }}</p>
    {% endif %}

    {% if section.settings.paragraph_3 != blank %}
      <p class="brand-story__text">{{ section.settings.paragraph_3 }}</p>
    {% endif %}

    {% if section.settings.paragraph_4 != blank %}
      <p class="brand-story__text">{{ section.settings.paragraph_4 }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FBF7F3"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Florine?"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "Florine Swim is named after my grandmother —a woman who carried quiet confidence wherever she went."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "She raised fourteen children and lived a life full of movement, care, and constant presence for others. Yet she carried herself with a calm strength and natural grace that never asked for attention."
    },
    {
      "type": "textarea",
      "id": "paragraph_3",
      "label": "Paragraph 3",
      "default": "As I have grown older, I realize how rare it is to find swimwear that allows women to feel that same ease —pieces that support real life instead of distracting from it."
    },
    {
      "type": "textarea",
      "id": "paragraph_4",
      "label": "Paragraph 4",
      "default": "Florine was created to offer something different: swimwear designed for presence."
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
