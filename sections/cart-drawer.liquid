<div
  class="cart-drawer"
  id="CartDrawer"
  data-cart-drawer
  aria-hidden="true"
  role="dialog"
  aria-label="Shopping cart"
  aria-modal="true"
>
  <div class="cart-drawer__backdrop" data-cart-drawer-close></div>

  <aside class="cart-drawer__panel" tabindex="-1">
    <header class="cart-drawer__header">
      <h2 class="cart-drawer__title">{{ section.settings.title | default: 'Your Cart' }}</h2>
      <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="Close cart">
        {%- render 'icon-x' -%}
      </button>
    </header>

    <div class="cart-drawer__body" data-cart-drawer-body>
      {%- comment -%} JavaScript renders contents into [data-cart-items] / [data-cart-empty]. {%- endcomment -%}
      <div class="cart-drawer__empty" data-cart-empty hidden>
        <p class="cart-drawer__empty-title">{{ section.settings.empty_title | default: 'Your cart is empty.' }}</p>
        <p class="cart-drawer__empty-message">{{ section.settings.empty_message | default: 'Quiet pieces, gently delivered when the time comes.' }}</p>
        <button type="button" class="btn btn--primary cart-drawer__empty-cta" data-cart-drawer-close>
          {{ section.settings.empty_button | default: 'Continue browsing' }}
        </button>
      </div>

      <ul class="cart-drawer__items" data-cart-items></ul>
    </div>

    <footer class="cart-drawer__footer" data-cart-footer hidden>
      <div class="cart-drawer__subtotal">
        <span class="cart-drawer__subtotal-label">{{ section.settings.subtotal_label | default: 'Subtotal' }}</span>
        <span class="cart-drawer__subtotal-amount" data-cart-subtotal></span>
      </div>
      <p class="cart-drawer__note">{{ section.settings.footer_note | default: 'Shipping & taxes calculated at checkout.' }}</p>
      <a href="{{ routes.cart_url }}/checkout" class="btn btn--primary cart-drawer__checkout" data-cart-checkout>
        {{ section.settings.checkout_label | default: 'Checkout' }}
      </a>
    </footer>
  </aside>
</div>

<template id="CartDrawerItemTemplate">
  <li class="cart-drawer__item" data-cart-item>
    <a class="cart-drawer__item-media" data-cart-item-link>
      <img data-cart-item-image alt="" loading="lazy" />
    </a>
    <div class="cart-drawer__item-body">
      <div class="cart-drawer__item-row">
        <div>
          <a class="cart-drawer__item-title" data-cart-item-title-link>
            <span data-cart-item-title></span>
          </a>
          <p class="cart-drawer__item-variant" data-cart-item-variant></p>
        </div>
        <p class="cart-drawer__item-price" data-cart-item-price></p>
      </div>
      <div class="cart-drawer__item-row cart-drawer__item-row--bottom">
        <div class="cart-drawer__item-qty" data-cart-item-quantity>
          <button type="button" class="cart-drawer__qty-btn" data-cart-item-decrement aria-label="Decrease quantity">−</button>
          <span class="cart-drawer__qty-value" data-cart-item-qty>1</span>
          <button type="button" class="cart-drawer__qty-btn" data-cart-item-increment aria-label="Increase quantity">+</button>
        </div>
        <button type="button" class="cart-drawer__item-remove" data-cart-item-remove>Remove</button>
      </div>
    </div>
  </li>
</template>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Your Cart"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Empty State Title",
      "default": "Your cart is empty."
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty State Message",
      "default": "Quiet pieces, gently delivered when the time comes."
    },
    {
      "type": "text",
      "id": "empty_button",
      "label": "Empty State Button",
      "default": "Continue browsing"
    },
    {
      "type": "text",
      "id": "subtotal_label",
      "label": "Subtotal Label",
      "default": "Subtotal"
    },
    {
      "type": "text",
      "id": "footer_note",
      "label": "Footer Note",
      "default": "Shipping & taxes calculated at checkout."
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout Button Label",
      "default": "Checkout"
    }
  ]
}
{% endschema %}
