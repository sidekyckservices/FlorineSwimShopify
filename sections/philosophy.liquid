<section class="philosophy section-padding" style="background-color: {{ section.settings.background_color }};">
  <div class="philosophy__inner animate-on-scroll">
    <div class="philosophy__content">
      <h2 class="philosophy__title">{{ section.settings.heading }}</h2>

      {% if section.settings.paragraph_1 != blank %}
        <p class="philosophy__text">{{ section.settings.paragraph_1 }}</p>
      {% endif %}
      {% if section.settings.paragraph_2 != blank %}
        <p class="philosophy__text">{{ section.settings.paragraph_2 }}</p>
      {% endif %}
      {% if section.settings.paragraph_3 != blank %}
        <p class="philosophy__text">{{ section.settings.paragraph_3 }}</p>
      {% endif %}

      <div class="divider philosophy__divider" aria-hidden="true"></div>

      {% if section.settings.quote_line_1 != blank %}
        <p class="philosophy__quote">{{ section.settings.quote_line_1 }}</p>
      {% endif %}
      {% if section.settings.quote_line_2 != blank %}
        <p class="philosophy__quote">{{ section.settings.quote_line_2 }}</p>
      {% endif %}
    </div>

    <div class="philosophy__media">
      {% if section.settings.image_1 != blank %}
        <img
          src="{{ section.settings.image_1 | image_url: width: 800 }}"
          alt="{{ section.settings.image_1.alt | default: 'Florine Swim crop top design sketch' }}"
          class="philosophy__sketch philosophy__sketch--top"
          loading="lazy"
        />
      {% else %}
        <img
          src="{{ 'sketch-top.png' | asset_url }}"
          alt="Florine Swim crop top design sketch — front and back view"
          class="philosophy__sketch philosophy__sketch--top"
          loading="lazy"
        />
      {% endif %}

      {% if section.settings.image_2 != blank %}
        <img
          src="{{ section.settings.image_2 | image_url: width: 800 }}"
          alt="{{ section.settings.image_2.alt | default: 'Florine Swim shorts design sketch' }}"
          class="philosophy__sketch philosophy__sketch--shorts"
          loading="lazy"
        />
      {% else %}
        <img
          src="{{ 'sketch-shorts.png' | asset_url }}"
          alt="Florine Swim shorts design sketch — front and back view"
          class="philosophy__sketch philosophy__sketch--shorts"
          loading="lazy"
        />
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Philosophy",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#E6DED3"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for Real Life."
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "Pool days that turn into errands. Beach walks that become long conversations. Family vacations, slow mornings, and everything in between."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "Florine Swim is made for the moments that matter."
    },
    {
      "type": "textarea",
      "id": "paragraph_3",
      "label": "Paragraph 3",
      "default": "Each piece is created with thoughtful coverage and gentle support, so nothing pulls, shifts, or distracts you from being present."
    },
    {
      "type": "text",
      "id": "quote_line_1",
      "label": "Quote Line 1",
      "default": "You are already enough."
    },
    {
      "type": "text",
      "id": "quote_line_2",
      "label": "Quote Line 2",
      "default": "We simply design swimwear that lets you feel it."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Sketch 1 (Top)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Sketch 2 (Shorts)"
    }
  ],
  "presets": [
    {
      "name": "Philosophy"
    }
  ]
}
{% endschema %}
