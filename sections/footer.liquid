<footer class="footer">
  <div class="footer__main">
    <div class="footer__brand">
      <a href="{{ routes.root_url }}" class="footer__brand-link" aria-label="{{ shop.name }} home">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 320 }}"
            alt="{{ shop.name }}"
            class="footer__logo"
            loading="lazy"
          />
        {% else %}
          <img
            src="{{ 'florine-logo.jpg' | asset_url }}"
            alt="{{ shop.name }}"
            class="footer__logo"
            loading="lazy"
          />
        {% endif %}
      </a>

      {% if section.settings.tagline != blank %}
        <p class="footer__tagline">{{ section.settings.tagline }}</p>
      {% endif %}

      {% if section.settings.show_newsletter %}
        {% form 'customer', id: 'footer-newsletter', class: 'footer__newsletter' %}
          {% if form.posted_successfully? %}
            <p class="footer__newsletter-success">You're on the list — we'll be in touch gently.</p>
          {% else %}
            <input type="hidden" name="contact[tags]" value="newsletter,footer" />
            <input type="hidden" name="contact[accepts_marketing]" value="true" />
            <div class="footer__newsletter-row">
              <input
                type="email"
                name="contact[email]"
                placeholder="{{ section.settings.newsletter_placeholder | default: 'Your email' }}"
                required
                class="footer__newsletter-input"
                aria-label="Email for newsletter"
              />
              <button type="submit" class="footer__newsletter-button">{{ section.settings.newsletter_button | default: 'Join' }}</button>
            </div>
            {% if form.errors %}
              <p class="footer__newsletter-error">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>
            {% endif %}
          {% endif %}
        {% endform %}
      {% endif %}
    </div>

    <div class="footer__columns">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'link_column' %}
            <div class="footer__column" {{ block.shopify_attributes }}>
              <h3 class="footer__column-title">{{ block.settings.heading }}</h3>
              <ul class="footer__column-list">
                {% if block.settings.link_1_label != blank %}
                  <li><a href="{{ block.settings.link_1_url | default: '#' }}" class="footer__column-link">{{ block.settings.link_1_label }}</a></li>
                {% endif %}
                {% if block.settings.link_2_label != blank %}
                  <li><a href="{{ block.settings.link_2_url | default: '#' }}" class="footer__column-link">{{ block.settings.link_2_label }}</a></li>
                {% endif %}
                {% if block.settings.link_3_label != blank %}
                  <li><a href="{{ block.settings.link_3_url | default: '#' }}" class="footer__column-link">{{ block.settings.link_3_label }}</a></li>
                {% endif %}
                {% if block.settings.link_4_label != blank %}
                  <li><a href="{{ block.settings.link_4_url | default: '#' }}" class="footer__column-link">{{ block.settings.link_4_label }}</a></li>
                {% endif %}
                {% if block.settings.link_5_label != blank %}
                  <li><a href="{{ block.settings.link_5_url | default: '#' }}" class="footer__column-link">{{ block.settings.link_5_label }}</a></li>
                {% endif %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="footer__column">
          <h3 class="footer__column-title">Shop</h3>
          <ul class="footer__column-list">
            <li><a href="/collections/all" class="footer__column-link">Shop All</a></li>
            <li><a href="/products/the-florine-swim-tee" class="footer__column-link">The Florine Tee</a></li>
            <li><a href="/collections/all" class="footer__column-link">Swim — Coming Soon</a></li>
          </ul>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="footer__bottom">
    <p class="footer__copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
    </p>

    <div class="footer__bottom-links">
      {% if section.settings.terms_url != blank %}
        <a href="{{ section.settings.terms_url }}" class="footer__bottom-link">Terms of Service</a>
      {% endif %}
      {% if section.settings.privacy_url != blank %}
        <a href="{{ section.settings.privacy_url }}" class="footer__bottom-link">Privacy Policy</a>
      {% endif %}
      {% if section.settings.instagram_url != blank %}
        <a
          href="{{ section.settings.instagram_url }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Follow {{ shop.name }} on Instagram"
          class="footer__social-link"
        >
          {% render 'icon-instagram' %}
        </a>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Swimwear and quiet essentials, made to feel like a slow exhale. Letters from Florine arrive only when there's something worth saying."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Newsletter Placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Newsletter Button",
      "default": "Join"
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Terms of Service URL"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Privacy Policy URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link Column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "text", "id": "link_1_label", "label": "Link 1 Label" },
        { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
        { "type": "text", "id": "link_2_label", "label": "Link 2 Label" },
        { "type": "url", "id": "link_2_url", "label": "Link 2 URL" },
        { "type": "text", "id": "link_3_label", "label": "Link 3 Label" },
        { "type": "url", "id": "link_3_url", "label": "Link 3 URL" },
        { "type": "text", "id": "link_4_label", "label": "Link 4 Label" },
        { "type": "url", "id": "link_4_url", "label": "Link 4 URL" },
        { "type": "text", "id": "link_5_label", "label": "Link 5 Label" },
        { "type": "url", "id": "link_5_url", "label": "Link 5 URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "link_column",
          "settings": {
            "heading": "Shop",
            "link_1_label": "Shop All",
            "link_2_label": "The Florine Tee",
            "link_3_label": "Swim — Coming Soon"
          }
        }
      ]
    }
  ]
}
{% endschema %}
