<section class="why-florine section-padding" style="background-color: {{ section.settings.background_color }};">
  <div class="why-florine__inner">
    <div class="why-florine__content animate-on-scroll">
      <h2 class="why-florine__title">{{ section.settings.heading }}</h2>

      {% if section.settings.paragraph_1 != blank %}
        <p class="why-florine__text">{{ section.settings.paragraph_1 }}</p>
      {% endif %}
      {% if section.settings.paragraph_2 != blank %}
        <p class="why-florine__text">{{ section.settings.paragraph_2 }}</p>
      {% endif %}
      {% if section.settings.paragraph_3 != blank %}
        <p class="why-florine__text">{{ section.settings.paragraph_3 }}</p>
      {% endif %}

      {% if section.settings.closing_quote != blank %}
        <p class="why-florine__quote">{{ section.settings.closing_quote }}</p>
      {% endif %}
    </div>

    <div class="why-florine__media animate-on-scroll">
      <div class="why-florine__media-frame">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.image.alt | default: 'Florine Swim brand image' }}"
            class="why-florine__image"
            loading="lazy"
            width="1200"
            height="1500"
          />
        {% else %}
          <img
            src="{{ 'why-florine.jpg' | asset_url }}"
            alt="A grandmother and granddaughter sharing a moment by the water"
            class="why-florine__image"
            loading="lazy"
          />
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Florine",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FBF7F3"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Florine?"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "Florine Swim is named after my grandmother — a woman who carried quiet confidence wherever she went."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "She raised fourteen children and lived a life full of movement, care, and constant presence for others. Yet she carried herself with a calm strength and natural grace that never asked for attention."
    },
    {
      "type": "textarea",
      "id": "paragraph_3",
      "label": "Paragraph 3",
      "default": "As I have grown older, I realize how rare it is to find swimwear that allows women to feel that same ease — pieces that support real life instead of distracting from it."
    },
    {
      "type": "textarea",
      "id": "closing_quote",
      "label": "Closing Quote",
      "default": "Florine was created to offer something different: swimwear designed for presence."
    }
  ],
  "presets": [
    {
      "name": "Why Florine"
    }
  ]
}
{% endschema %}
