<section class="principles section-padding">
  <div class="principles__inner animate-on-scroll">
    <h2 class="principles__title">{{ section.settings.heading }}</h2>

    <div class="principles__grid">
      {% for block in section.blocks %}
        {% assign delay_ms = forloop.index0 | times: 150 %}
        {% assign delay_s = delay_ms | divided_by: 1000.0 %}
        <div
          class="principles__card animate-on-scroll-child"
          data-delay="{{ delay_s }}"
          style="transition-delay: {{ delay_s }}s;"
          {{ block.shopify_attributes }}
        >
          <div class="principles__icon">
            {% case block.settings.icon %}
              {% when 'feather' %}
                {% render 'icon-feather' %}
              {% when 'shield' %}
                {% render 'icon-shield' %}
              {% when 'flower' %}
                {% render 'icon-flower' %}
              {% when 'sun' %}
                {% render 'icon-sun' %}
            {% endcase %}
          </div>
          <h3 class="principles__card-title">{{ block.settings.title }}</h3>
          <p class="principles__card-description">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Principles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtfully Considered."
    }
  ],
  "blocks": [
    {
      "type": "principle",
      "name": "Principle",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "feather", "label": "Feather" },
            { "value": "shield", "label": "Shield" },
            { "value": "flower", "label": "Flower" },
            { "value": "sun", "label": "Sun" }
          ],
          "default": "feather"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Principle"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Description of this principle."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Principles",
      "blocks": [
        {
          "type": "principle",
          "settings": {
            "icon": "feather",
            "title": "Ease Over Effort",
            "description": "Swimwear designed so nothing needs fixing or adjusting."
          }
        },
        {
          "type": "principle",
          "settings": {
            "icon": "shield",
            "title": "Comfort You Can Trust",
            "description": "Support that feels natural, never restrictive."
          }
        },
        {
          "type": "principle",
          "settings": {
            "icon": "flower",
            "title": "Quiet Femininity",
            "description": "Soft, polished silhouettes that feel beautiful without revealing more than you'd like."
          }
        },
        {
          "type": "principle",
          "settings": {
            "icon": "sun",
            "title": "Presence in the Moment",
            "description": "Made so you can focus on connection, sunlight, and stillness — not your swimsuit."
          }
        }
      ]
    }
  ]
}
{% endschema %}
