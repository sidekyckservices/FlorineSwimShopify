<section class="principles section-padding"
  style="background-color: {{ section.settings.background_color }};{% if section.settings.background_image != blank %} background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}'); background-size: cover; background-position: center;{% endif %}">
  <div class="principles__inner animate-on-scroll">
    <h2 class="principles__title">{{ section.settings.heading }}</h2>

    <div class="principles__grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign delay_ms = forloop.index0 | times: 150 %}
          {% assign delay_s = delay_ms | divided_by: 1000.0 %}
          <div
            class="principles__card animate-on-scroll-child"
            data-delay="{{ delay_s }}"
            style="transition-delay: {{ delay_s }}s;"
            {{ block.shopify_attributes }}
          >
            <div class="principles__icon">
              {% case block.settings.icon %}
                {% when 'feather' %}{% render 'icon-feather' %}
                {% when 'shield' %}{% render 'icon-shield' %}
                {% when 'flower' %}{% render 'icon-flower' %}
                {% when 'sun' %}{% render 'icon-sun' %}
                {% when 'heart' %}{% render 'icon-heart' %}
                {% when 'wave' %}{% render 'icon-wave' %}
                {% when 'leaf' %}{% render 'icon-leaf' %}
                {% when 'droplet' %}{% render 'icon-droplet' %}
                {% when 'star' %}{% render 'icon-star' %}
                {% when 'moon' %}{% render 'icon-moon' %}
                {% when 'cloud' %}{% render 'icon-cloud' %}
                {% when 'sparkle' %}{% render 'icon-sparkle' %}
                {% when 'pearl' %}{% render 'icon-pearl' %}
                {% when 'palm' %}{% render 'icon-palm' %}
                {% when 'shell' %}{% render 'icon-shell' %}
                {% when 'butterfly' %}{% render 'icon-butterfly' %}
                {% when 'lotus' %}{% render 'icon-lotus' %}
                {% when 'breeze' %}{% render 'icon-breeze' %}
                {% when 'mountain' %}{% render 'icon-mountain' %}
                {% when 'sunrise' %}{% render 'icon-sunrise' %}
                {% when 'compass' %}{% render 'icon-compass' %}
                {% when 'anchor' %}{% render 'icon-anchor' %}
                {% when 'gem' %}{% render 'icon-gem' %}
                {% when 'ribbon' %}{% render 'icon-ribbon' %}
                {% when 'eye' %}{% render 'icon-eye' %}
                {% when 'hand' %}{% render 'icon-hand' %}
                {% when 'circle' %}{% render 'icon-circle' %}
                {% when 'infinity' %}{% render 'icon-infinity' %}
                {% when 'dove' %}{% render 'icon-dove' %}
              {% endcase %}
            </div>
            <h3 class="principles__card-title">{{ block.settings.title }}</h3>
            <p class="principles__card-description">{{ block.settings.description }}</p>
          </div>
        {% endfor %}
      {% else %}
        <div class="principles__card animate-on-scroll-child" data-delay="0" style="transition-delay: 0s;">
          <div class="principles__icon">{% render 'icon-feather' %}</div>
          <h3 class="principles__card-title">Gentle by Design</h3>
          <p class="principles__card-description">Soft construction and feminine silhouettes that move with your body -- not against it.</p>
        </div>
        <div class="principles__card animate-on-scroll-child" data-delay="0.15" style="transition-delay: 0.15s;">
          <div class="principles__icon">{% render 'icon-shield' %}</div>
          <h3 class="principles__card-title">Quiet Confidence</h3>
          <p class="principles__card-description">Thoughtful coverage and support that lets you move freely, without adjusting or worrying.</p>
        </div>
        <div class="principles__card animate-on-scroll-child" data-delay="0.3" style="transition-delay: 0.3s;">
          <div class="principles__icon">{% render 'icon-flower' %}</div>
          <h3 class="principles__card-title">Considered Quality</h3>
          <p class="principles__card-description">Made from premium, lasting materials -- because swimwear should age as gracefully as you.</p>
        </div>
        <div class="principles__card animate-on-scroll-child" data-delay="0.45" style="transition-delay: 0.45s;">
          <div class="principles__icon">{% render 'icon-sun' %}</div>
          <h3 class="principles__card-title">For Real Life</h3>
          <p class="principles__card-description">Pool days, beach walks, and everything in between. No posing required.</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Principles",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FBF7F3"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtfully Considered."
    }
  ],
  "blocks": [
    {
      "type": "principle",
      "name": "Principle",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "feather", "label": "Feather" },
            { "value": "shield", "label": "Shield" },
            { "value": "flower", "label": "Flower" },
            { "value": "sun", "label": "Sun" },
            { "value": "heart", "label": "Heart" },
            { "value": "wave", "label": "Wave" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "star", "label": "Star" },
            { "value": "moon", "label": "Moon" },
            { "value": "cloud", "label": "Cloud" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "pearl", "label": "Pearl" },
            { "value": "palm", "label": "Palm Tree" },
            { "value": "shell", "label": "Shell" },
            { "value": "butterfly", "label": "Butterfly" },
            { "value": "lotus", "label": "Lotus" },
            { "value": "breeze", "label": "Breeze" },
            { "value": "mountain", "label": "Mountain" },
            { "value": "sunrise", "label": "Sunrise" },
            { "value": "compass", "label": "Compass" },
            { "value": "anchor", "label": "Anchor" },
            { "value": "gem", "label": "Gem" },
            { "value": "ribbon", "label": "Ribbon" },
            { "value": "eye", "label": "Eye" },
            { "value": "hand", "label": "Hand" },
            { "value": "circle", "label": "Circle" },
            { "value": "infinity", "label": "Infinity" },
            { "value": "dove", "label": "Dove" }
          ],
          "default": "feather"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Principle"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Description of this principle."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Principles",
      "blocks": [
        {
          "type": "principle",
          "settings": {
            "icon": "feather",
            "title": "Gentle by Design",
            "description": "Soft construction and feminine silhouettes that move with your body."
          }
        },
        {
          "type": "principle",
          "settings": {
            "icon": "shield",
            "title": "Quiet Confidence",
            "description": "Thoughtful coverage and support that lets you move freely."
          }
        },
        {
          "type": "principle",
          "settings": {
            "icon": "flower",
            "title": "Considered Quality",
            "description": "Made from premium, lasting materials."
          }
        },
        {
          "type": "principle",
          "settings": {
            "icon": "sun",
            "title": "For Real Life",
            "description": "Pool days, beach walks, and everything in between."
          }
        }
      ]
    }
  ]
}
{% endschema %}
